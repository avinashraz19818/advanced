# .env ko repo me commit MAT karo (yeh file .gitignore me hai).
# Server par:  echo 'MAIN_BOT_TOKEN=<BotFather se naya token>' > .env
MAIN_BOT_TOKEN=
# Default: postgresql://postgres:postgres@localhost:5432/advanced_bot
DATABASE_URL=
# Extra admins (comma separated), optional
ADMIN_USER_IDS=
# Agar logs me "httpx.ReadError" / "NetworkError" baar-baar aaye (VPS ka IPv6 route
# toota hota hai) to ye 1 kar do -> bot sirf IPv4 use karega (Telegram IPv4 par chalta hai)
FORCE_IPV4=0
# Button Builder Mini App (webapp/index.html) ka HTTPS URL.
# Set karne par button builder me "🌐 Mini App" tab aata hai (visual builder, easy).
# HTTPS zaroori hai. Examples:
#   GitHub Pages : https://<username>.github.io/advanced/
#   Cloudflare   : https://<random>.trycloudflare.com
#   Apna domain  : https://buttons.yourdomain.com
WEBAPP_URL=

