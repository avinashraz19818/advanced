# ==========================================================
#  advacc — .env example
#  Is file ko copy karke `.env` naam se rakhein aur values
#  bharein. `.env` kabhi git me commit NAHI hoga.
# ==========================================================

# ── Bot token (BotFather se) ──────────────────────────────
MAIN_BOT_TOKEN=123456789:AAExampleReplaceMeWithYourRealBotToken

# ── MongoDB (Atlas ya local) ──────────────────────────────
# Atlas SRV example:
#   MONGO_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/?appName=Cluster0
# Local example:
#   MONGO_URI=mongodb://127.0.0.1:27017
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=advacc_bot

# ── User account (Telethon StringSession) ─────────────────
# Generate karne ke liye ek baar chalayein:  python3 login_userbot.py
# Ye secret hai — kisi ke saath share na karein.
USERBOT_SESSION=

# Telethon API credentials (default: public Telegram Desktop values)
# Apne https://my.telegram.org ke values daal sakte hain (recommended).
API_ID=6
API_HASH=eb06d4abfb49dc3eeb1aeb98ae0f581e

# ── Admins (comma-separated Telegram user ids) ────────────
ADMIN_USER_IDS=8015937475

# ── Optional branding ─────────────────────────────────────
ADMIN_USERNAME=@zayro_o
