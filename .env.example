# .env ko repo me commit MAT karo (yeh file .gitignore me hai).
# Server par:  echo 'MAIN_BOT_TOKEN=<BotFather se naya token>' > .env
MAIN_BOT_TOKEN=
# Default: postgresql://postgres:postgres@localhost:5432/advanced_bot
DATABASE_URL=
# Extra admins (comma separated), optional
ADMIN_USER_IDS=
# Agar logs me "httpx.ReadError" / "NetworkError" baar-baar aaye (VPS ka IPv6 route
# toota hota hai) to ye 1 kar do -> bot sirf IPv4 use karega (Telegram IPv4 par chalta hai)
FORCE_IPV4=0

# --- User account (MTProto) mode ke liye (optional) ---
# Ek baar https://my.telegram.org -> API development tools se api_id/api_hash lo.
# Uske baad panel me "👤 User Account" chuno aur phone + OTP se login karo.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# User account se bulk DM me Telegram spam-limit na lagaye, isliye per-message gap (seconds)
USER_ACCOUNT_SEND_DELAY=2.0
