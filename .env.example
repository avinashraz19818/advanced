# ==============================================================
#  Bot configuration (copy this file to `.env` and fill it in)
#  IMPORTANT: `.env` is gitignored — NEVER commit a real token.
# ==============================================================

# REQUIRED — the MAIN bot's token from @BotFather.
# (No token is hardcoded in the code anymore. If this is missing the
#  bot refuses to start. A committed/hardcoded token can be stolen —
#  that is exactly what caused the "token chori" / Conflict spam before.)
MAIN_BOT_TOKEN="123456789:AAAddd...replace_me..."

# Optional — extra admin user IDs (comma separated). The primary admin
# is already set in the code; add more here if needed.
# ADMIN_USER_IDS="111111,222222"

# Optional — Postgres connection if you do not use the default
# (default: postgresql://postgres:postgres@localhost:5432/advanced_bot)
# DATABASE_URL="postgresql://user:pass@host:5432/dbname"
