# Is file ko copy karke ".env" naam se save karo (usi folder me jahan advanced.py hai):
#     cp .env.example .env
# phir apna token bharo aur:  bash start
#
# .env .gitignore me hai -> token git/GitHub par kabhi nahi jayega.

# Main (admin/client panel) bot ka BotFather token - REQUIRED
MAIN_BOT_TOKEN=123456789:AA-your-botfather-token-here

# Extra admins (optional, comma separated user IDs)
# ADMIN_USER_IDS=111111111,222222222
